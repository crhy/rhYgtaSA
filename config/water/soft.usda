#usda 1.0
# s32 water variant 'soft' - the same material as 'realistic', but the normal sheet is
# regenerated: @./water_normal_soft.dds@ instead of the pack's @./water_normal.dds@.
# Generated by REPO/tools/water_normal_soft.py from the pack's own BC5 sheet (it is never
# written over): same 20-frame layout, so sprite_sheet_cols/rows/fps below stay valid.
# Measured on the pack's sheet: median facet tilt 44 deg, 32% of texels over 60 deg,
# |grad tilt| 21.3 deg/texel, tilt decorrelated after 10 px of a 512 px frame -> the sea reads
# as a per-pixel black/white sheet (the 2026-11-12 water shot: high-pass residual autocorrelation
# drops below 0.5 at lag 2 px). The regenerated sheet: 12 deg median, 0% over 60 deg,
# 2.2 deg/texel, decorrelated after 17 px of a 128 px frame.
# AperturePBR_Translucent.mdl has no normal-strength / roughness / UV-scale input, so the map is
# the only place left to fix it; see REPO/.strata/notes-s32-water-vegetation.md.
# With this map the rtx.conf normal-strength knob should go back up (the map already carries the
# softening): rtx.translucentMaterial.normalIntensity = 1.0.
(
    customLayerData = {
        dictionary omni_layer = {
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
    }
    upAxis = "Z"
)

over "RootNode"
{
    over "Looks"
    {
        over "mat_59296793798A7318"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @../../materials/AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.3299999 (
                    customData = {
                        float default = 1.3
                        dictionary range = {
                            float max = 3
                            float min = 1
                        }
                    }
                    displayGroup = "Specular"
                    displayName = "Index of Refraction"
                    doc = """Index of Refraction of the material

"""
                    hidden = false
                )
                asset inputs:normalmap_texture = @./water_normal_soft.dds@ (
                    colorSpace = "auto"
                    customData = {
                        asset default = @@
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map"
                    hidden = false
                    renderType = "texture_2d"
                )
                int inputs:sprite_sheet_cols = 20 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Columns"
                    doc = """Number of columns the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 20 frames / 12 fps = 1.67 s loop (pack: 20 fps = 1.0 s, 15 fps = 1.33 s).
                # The 20 frames are one decorrelated ripple field; at 20 fps the surface
                # re-randomises every frame and reads as boiling noise, and it also throws away
                # DLSS-RR's temporal history (see the runtime's invalidateHistoryForAnimatedWater).
                int inputs:sprite_sheet_fps = 12 (
                    customData = {
                        int default = 0
                        dictionary range = {
                            int max = 255
                            int min = 0
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet FPS"
                    doc = """Framerate in Frames Per Second to use for the spritesheet across all textures. Note that a value of 0 disables this functionality.

"""
                    hidden = false
                )
                int inputs:sprite_sheet_rows = 1 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Rows"
                    doc = """Number of row the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 0: the sea is a volume, so the tint comes from absorption along the ray path.
                bool inputs:thin_walled = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Specular"
                    displayName = "Thin-walled"
                    doc = """Whether the material is thin-walled, use when material is being applied to single triangle thick geometry.

"""
                    hidden = false
                )
                # Beer-Lambert: sigma = -ln(T)/d. Jerlov type III (coastal) water:
                # T=(0.05,0.22,0.45) over 20 m -> sigma=(0.150,0.076,0.040) 1/m -> 1/e depths
                # 6.7 m red, 13 m green, 25 m blue: the sea turns dark blue-green within a few
                # metres instead of staying pale glass. The pack's (0.125,0.365,0.529) over 50 m
                # is sigma=(0.042,0.020,0.013) 1/m = Jerlov I clear ocean (1/e ~24/50/78 m),
                # far too transparent for the bay, which is why it reads as a glass sheet.
                color3f inputs:transmittance_color = (0.05, 0.22, 0.45) (
                    customData = {
                        float3 default = (0.97, 0.97, 0.97)
                        dictionary range = {
                            float3 max = (1, 1, 1)
                            float3 min = (0, 0, 0)
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Color"
                    doc = """Expected transmittance after the specified transmittance distance through the volume.

"""
                    hidden = false
                    renderType = "color"
                )
                float inputs:transmittance_measurement_distance = 20 (
                    customData = {
                        float default = 1
                        dictionary range = {
                            float max = 65504
                            float min = 0.001
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Measurement Distance"
                    doc = """Distance to match the transmittance through the volume at.

"""
                    hidden = false
                )
                bool inputs:use_diffuse_layer = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Volume"
                    displayName = "Use diffuse layer"
                    doc = """When set, simulates a diffuse layer on top of the material

"""
                    hidden = false
                )
                # 0 = octahedral (AperturePBR_Normal::normalmap_encoding). water_normal.dds is
                # BC5_UNORM = 2 channels (R,G). The tangent-space decodings (1/2) do
                # lookup_float3 -> B reads 0 on a 2-channel texture -> z = 2*0-1 = -1, i.e. every
                # facet normal points down into the water: the surface goes black everywhere.
                # Octahedral is therefore the only encoding this texture can use. The pack never
                # wrote this input, so it is pinned here to make the decode explicit.
                int inputs:encoding = 0 (
                    customData = {
                        int default = 0
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map Encoding"
                    doc = """Encoding type for the normal map.  Octahedral for 2 channel textures. tangent_space_dx for 3 channel normals, and tangent_space_ogl for 3 channel normals with an inverted (OpenGL style) G channel.

"""
                    hidden = true
                )
            }
        }

        over "mat_A75A0B41F2454F04"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @../../materials/AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.3299999 (
                    customData = {
                        float default = 1.3
                        dictionary range = {
                            float max = 3
                            float min = 1
                        }
                    }
                    displayGroup = "Specular"
                    displayName = "Index of Refraction"
                    doc = """Index of Refraction of the material

"""
                    hidden = false
                )
                asset inputs:normalmap_texture = @./water_normal_soft.dds@ (
                    colorSpace = "auto"
                    customData = {
                        asset default = @@
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map"
                    hidden = false
                    renderType = "texture_2d"
                )
                int inputs:sprite_sheet_cols = 20 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Columns"
                    doc = """Number of columns the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 20 frames / 12 fps = 1.67 s loop (pack: 20 fps = 1.0 s, 15 fps = 1.33 s).
                # The 20 frames are one decorrelated ripple field; at 20 fps the surface
                # re-randomises every frame and reads as boiling noise, and it also throws away
                # DLSS-RR's temporal history (see the runtime's invalidateHistoryForAnimatedWater).
                int inputs:sprite_sheet_fps = 12 (
                    customData = {
                        int default = 0
                        dictionary range = {
                            int max = 255
                            int min = 0
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet FPS"
                    doc = """Framerate in Frames Per Second to use for the spritesheet across all textures. Note that a value of 0 disables this functionality.

"""
                    hidden = false
                )
                int inputs:sprite_sheet_rows = 1 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Rows"
                    doc = """Number of row the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 0: the sea is a volume, so the tint comes from absorption along the ray path.
                bool inputs:thin_walled = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Specular"
                    displayName = "Thin-walled"
                    doc = """Whether the material is thin-walled, use when material is being applied to single triangle thick geometry.

"""
                    hidden = false
                )
                # Beer-Lambert: sigma = -ln(T)/d. Jerlov type III (coastal) water:
                # T=(0.05,0.22,0.45) over 20 m -> sigma=(0.150,0.076,0.040) 1/m -> 1/e depths
                # 6.7 m red, 13 m green, 25 m blue: the sea turns dark blue-green within a few
                # metres instead of staying pale glass. The pack's (0.125,0.365,0.529) over 50 m
                # is sigma=(0.042,0.020,0.013) 1/m = Jerlov I clear ocean (1/e ~24/50/78 m),
                # far too transparent for the bay, which is why it reads as a glass sheet.
                color3f inputs:transmittance_color = (0.05, 0.22, 0.45) (
                    customData = {
                        float3 default = (0.97, 0.97, 0.97)
                        dictionary range = {
                            float3 max = (1, 1, 1)
                            float3 min = (0, 0, 0)
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Color"
                    doc = """Expected transmittance after the specified transmittance distance through the volume.

"""
                    hidden = false
                    renderType = "color"
                )
                float inputs:transmittance_measurement_distance = 20 (
                    customData = {
                        float default = 1
                        dictionary range = {
                            float max = 65504
                            float min = 0.001
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Measurement Distance"
                    doc = """Distance to match the transmittance through the volume at.

"""
                    hidden = false
                )
                bool inputs:use_diffuse_layer = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Volume"
                    displayName = "Use diffuse layer"
                    doc = """When set, simulates a diffuse layer on top of the material

"""
                    hidden = false
                )
                # 0 = octahedral (AperturePBR_Normal::normalmap_encoding). water_normal.dds is
                # BC5_UNORM = 2 channels (R,G). The tangent-space decodings (1/2) do
                # lookup_float3 -> B reads 0 on a 2-channel texture -> z = 2*0-1 = -1, i.e. every
                # facet normal points down into the water: the surface goes black everywhere.
                # Octahedral is therefore the only encoding this texture can use. The pack never
                # wrote this input, so it is pinned here to make the decode explicit.
                int inputs:encoding = 0 (
                    customData = {
                        int default = 0
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map Encoding"
                    doc = """Encoding type for the normal map.  Octahedral for 2 channel textures. tangent_space_dx for 3 channel normals, and tangent_space_ogl for 3 channel normals with an inverted (OpenGL style) G channel.

"""
                    hidden = true
                )
            }
        }
    }
}

