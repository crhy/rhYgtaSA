#usda 1.0
# s02 water variant 'calm' - shallow, sheltered water (bay / harbour / canal, sand bottom).
# Only inputs that AperturePBR_Translucent.mdl actually declares are changed; the mdl has no
# normal-strength, roughness or UV-scale input (see REPO/.strata/notes-s02-water.md).
(
    customLayerData = {
        dictionary omni_layer = {
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
    }
    upAxis = "Z"
)

over "RootNode"
{
    over "Looks"
    {
        over "mat_59296793798A7318"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @../../materials/AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.3299999 (
                    customData = {
                        float default = 1.3
                        dictionary range = {
                            float max = 3
                            float min = 1
                        }
                    }
                    displayGroup = "Specular"
                    displayName = "Index of Refraction"
                    doc = """Index of Refraction of the material

"""
                    hidden = false
                )
                asset inputs:normalmap_texture = @./water_normal.dds@ (
                    colorSpace = "auto"
                    customData = {
                        asset default = @@
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map"
                    hidden = false
                    renderType = "texture_2d"
                )
                int inputs:sprite_sheet_cols = 20 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Columns"
                    doc = """Number of columns the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 20 frames / 8 fps = 2.5 s loop: slow swell for a lee, and the least temporal
                # churn of the three variants (fewer per-frame normal changes to denoise).
                int inputs:sprite_sheet_fps = 8 (
                    customData = {
                        int default = 0
                        dictionary range = {
                            int max = 255
                            int min = 0
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet FPS"
                    doc = """Framerate in Frames Per Second to use for the spritesheet across all textures. Note that a value of 0 disables this functionality.

"""
                    hidden = false
                )
                int inputs:sprite_sheet_rows = 1 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Rows"
                    doc = """Number of row the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 1: the game's water is a single-sided sheet, so with thin_walled=0 nothing
                # bounds the volume and the absorption path length is undefined. Making it
                # thin-walled with an explicit thickness gives a deterministic Beer-Lambert
                # tint (T = exp(-sigma*thin_wall_thickness)) instead of an unbounded one.
                bool inputs:thin_walled = 1 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Specular"
                    displayName = "Thin-walled"
                    doc = """Whether the material is thin-walled, use when material is being applied to single triangle thick geometry.

"""
                    hidden = false
                )
                # sigma = -ln(T)/d = (0.161,0.080,0.060) 1/m (Jerlov type III, turbid coastal).
                # Over the 3 m sheet below that is T = exp(-sigma*3) = (0.62,0.79,0.84):
                # bright green-blue shallow water over sand, still clearly water and not a mirror.
                color3f inputs:transmittance_color = (0.20, 0.45, 0.55) (
                    customData = {
                        float3 default = (0.97, 0.97, 0.97)
                        dictionary range = {
                            float3 max = (1, 1, 1)
                            float3 min = (0, 0, 0)
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Color"
                    doc = """Expected transmittance after the specified transmittance distance through the volume.

"""
                    hidden = false
                    renderType = "color"
                )
                float inputs:transmittance_measurement_distance = 10 (
                    customData = {
                        float default = 1
                        dictionary range = {
                            float max = 65504
                            float min = 0.001
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Measurement Distance"
                    doc = """Distance to match the transmittance through the volume at.

"""
                    hidden = false
                )
                bool inputs:use_diffuse_layer = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Volume"
                    displayName = "Use diffuse layer"
                    doc = """When set, simulates a diffuse layer on top of the material

"""
                    hidden = false
                )
                # Simulated thickness of the single-sided water sheet, in metres.
                float inputs:thin_wall_thickness = 3 (
                    customData = {
                        float default = 1
                        dictionary range = {
                            float max = 65504
                            float min = 0.001
                        }
                    }
                    displayGroup = "Specular"
                    displayName = "Thin-walled material thickness"
                    doc = """Simulated thickness for thin-walled materials (0 disables thin-walled mode)

"""
                    hidden = false
                )
                # 0 = octahedral (AperturePBR_Normal::normalmap_encoding). water_normal.dds is
                # BC5_UNORM = 2 channels (R,G). The tangent-space decodings (1/2) do
                # lookup_float3 -> B reads 0 on a 2-channel texture -> z = 2*0-1 = -1, i.e. every
                # facet normal points down into the water: the surface goes black everywhere.
                # Octahedral is therefore the only encoding this texture can use. The pack never
                # wrote this input, so it is pinned here to make the decode explicit.
                int inputs:encoding = 0 (
                    customData = {
                        int default = 0
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map Encoding"
                    doc = """Encoding type for the normal map.  Octahedral for 2 channel textures. tangent_space_dx for 3 channel normals, and tangent_space_ogl for 3 channel normals with an inverted (OpenGL style) G channel.

"""
                    hidden = true
                )
            }
        }

        over "mat_A75A0B41F2454F04"
        {
            over "Shader"
            {
