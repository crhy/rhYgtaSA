#usda 1.0
# n07 water variant 'remix-ref' - the water setup the 2026-11-12 research (finding H) points at,
# expressed with inputs this mdl actually declares. Research log and every URL:
# REPO/.strata/notes-n07-water-research.md. What changed vs 'realistic', and who does it that way:
#
#   transmittance_color (0.62, 0.80, 0.80) @ transmittance_measurement_distance 4
#       xoxor4d's GTA IV RTX ships exactly these numbers as its default Remix-API water material -
#       https://raw.githubusercontent.com/xoxor4d/gta4-rtx/HEAD/src/gta4/modules/water.hpp
#       (ior 1.33, transmittance_color {0.62,0.8,0.8}, transmittance_distance 4.0) - the only
#       GTA-scale water body in the Remix ecosystem whose numbers we can read. Beer-Lambert sigma = -ln(T)/d = (0.119, 0.056, 0.056) 1/m, i.e. 1/e
#       depths 8.4 / 18 / 18 m: pale aqua in the first couple of metres, dark teal by ten.
#       NVIDIA's own Minecraft mod defaults to (0.9,0.95,1.0) @ 10 m
#       (https://raw.githubusercontent.com/NVIDIAGameWorks/rtx-remix-minecraft/HEAD/rtxremix-java/src/com/nvidia/rtxremix/MaterialInfoTranslucentEXT.java)
#       and GTA2 RTX to (0.45,0.75,0.55) @ 1 m over an authored sand riverbed
#       (https://raw.githubusercontent.com/gebdag/gta2-rtx-remix/HEAD/package/rtx-remix/mods/gta2water/mod.usda)
#       - all three are pale-and-shallow, none is the pack's saturated deep blue at 50 m (Jerlov I
#       open ocean, far too clear for the LA coast: s02).
#   normalmap_texture @./water_normal_ref.dds@
#       generated by REPO/tools/water_normal_soft.py from the pack's own sheet (never written over)
#       at --target-tilt 6: median facet tilt 44 -> 6.0 deg, p95 90 -> 9.3 deg, 0 % over 60 deg,
#       |grad tilt| 21.34 -> 1.00 deg/texel, 51 -> 7 independent facets per frame along u.
#       Both NVIDIA and GTA2 RTX *generate* the wave sheet rather than repair one, both write it
#       octahedral in R/G with a full mip chain, and NVIDIA's shipped ocean sits at slope_rms 0.0325
#       (median tilt ~2.2 deg) over a 10 m tile:
#       https://raw.githubusercontent.com/NVIDIAGameWorks/rtx-remix-minecraft/HEAD/tools/src/rtx_tools/water_normals.py
#       https://raw.githubusercontent.com/gebdag/gta2-rtx-remix/HEAD/tools/make_water_mod.py
#       6 deg is between NVIDIA's calm ocean and the 12 deg
#       'soft' sheet, because the world size of one frame of the pack's sheet is still unmeasured
#       (.strata/notes-s02-water.md open item 3) - at an unknown UV density a smaller tilt is the
#       safer half of the trade. The mdl has no normal-strength, roughness, UV-scale or scroll input
#       (checked against $G/.../materials/AperturePBR_Translucent.mdl), so the map stays the only
#       place the high frequencies can be removed.
#   sprite_sheet_fps 12 (pack: 20 / 15)
#       the runtime animates the water itself when the surface is in rtx.animatedWaterTextures:
#       https://raw.githubusercontent.com/NVIDIAGameWorks/dxvk-remix/remix-1.6.1/src/dxvk/shaders/rtx/concept/surface_material/translucent_surface_material_interaction.slangh
#       lines 62-83 take frac(uv*cols), add time*rtx.translucentMaterial.animatedWaterPrimaryNormalMotion,
#       and sample the normal map a second time at animatedWaterSecondaryNormalLodBias. Flipbook + UV scroll add up, so the
#       flipbook can go slow (12 fps, 1.67 s loop) and stop re-randomising the surface every frame.
#   thin_walled 0, use_diffuse_layer 0, encoding 0, ior 1.33, sprite_sheet 20x1 - as in 'realistic':
#       every project surveyed uses thin_walled 0 for water (NVIDIA API default useThinWall=false,
#       GTA2 RTX mod.usda thin_walled = 0, the pack itself), IOR 1.33 everywhere, and
#       use_diffuse_layer without a transmittance_texture is a no-op in this mdl (s02 step 1).
#
# Rollback: tools/water.sh pack restores the pack's file byte for byte.
(
    customLayerData = {
        dictionary omni_layer = {
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
    }
    upAxis = "Z"
)

over "RootNode"
{
    over "Looks"
    {
        over "mat_59296793798A7318"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @../../materials/AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.3299999 (
                    customData = {
                        float default = 1.3
                        dictionary range = {
                            float max = 3
                            float min = 1
                        }
                    }
                    displayGroup = "Specular"
                    displayName = "Index of Refraction"
                    doc = """Index of Refraction of the material

"""
                    hidden = false
                )
                asset inputs:normalmap_texture = @./water_normal_ref.dds@ (
                    colorSpace = "auto"
                    customData = {
                        asset default = @@
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map"
                    hidden = false
                    renderType = "texture_2d"
                )
                int inputs:sprite_sheet_cols = 20 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Columns"
                    doc = """Number of columns the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 20 frames / 12 fps = 1.67 s loop (pack: 20 fps = 1.0 s, 15 fps = 1.33 s).
                # The 20 frames are one decorrelated ripple field; at 20 fps the surface
                # re-randomises every frame and reads as boiling noise, and it also throws away
                # DLSS-RR's temporal history (see the runtime's invalidateHistoryForAnimatedWater).
                int inputs:sprite_sheet_fps = 12 (
                    customData = {
                        int default = 0
                        dictionary range = {
                            int max = 255
                            int min = 0
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet FPS"
                    doc = """Framerate in Frames Per Second to use for the spritesheet across all textures. Note that a value of 0 disables this functionality.

"""
                    hidden = false
                )
                int inputs:sprite_sheet_rows = 1 (
                    customData = {
                        int default = 1
                        dictionary range = {
                            int max = 255
                            int min = 1
                        }
                    }
                    displayGroup = "Animation"
                    displayName = "Sprite Sheet Rows"
                    doc = """Number of row the spritesheet across all textures is divided into.

"""
                    hidden = false
                )
                # 0: the sea is a volume, so the tint comes from absorption along the ray path.
                bool inputs:thin_walled = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Specular"
                    displayName = "Thin-walled"
                    doc = """Whether the material is thin-walled, use when material is being applied to single triangle thick geometry.

"""
                    hidden = false
                )
                # Beer-Lambert: sigma = -ln(T)/d. Jerlov type III (coastal) water:
                # T=(0.05,0.22,0.45) over 20 m -> sigma=(0.150,0.076,0.040) 1/m -> 1/e depths
                # 6.7 m red, 13 m green, 25 m blue: the sea turns dark blue-green within a few
                # metres instead of staying pale glass. The pack's (0.125,0.365,0.529) over 50 m
                # is sigma=(0.042,0.020,0.013) 1/m = Jerlov I clear ocean (1/e ~24/50/78 m),
                # far too transparent for the bay, which is why it reads as a glass sheet.
                color3f inputs:transmittance_color = (0.62, 0.8, 0.8) (
                    customData = {
                        float3 default = (0.97, 0.97, 0.97)
                        dictionary range = {
                            float3 max = (1, 1, 1)
                            float3 min = (0, 0, 0)
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Color"
                    doc = """Expected transmittance after the specified transmittance distance through the volume.

"""
                    hidden = false
                    renderType = "color"
                )
                float inputs:transmittance_measurement_distance = 4 (
                    customData = {
                        float default = 1
                        dictionary range = {
                            float max = 65504
                            float min = 0.001
                        }
                    }
                    displayGroup = "Volume"
                    displayName = "Transmittance Measurement Distance"
                    doc = """Distance to match the transmittance through the volume at.

"""
                    hidden = false
                )
                bool inputs:use_diffuse_layer = 0 (
                    customData = {
                        bool default = 0
                    }
                    displayGroup = "Volume"
                    displayName = "Use diffuse layer"
                    doc = """When set, simulates a diffuse layer on top of the material

"""
                    hidden = false
                )
                # 0 = octahedral (AperturePBR_Normal::normalmap_encoding). water_normal.dds is
                # BC5_UNORM = 2 channels (R,G). The tangent-space decodings (1/2) do
                # lookup_float3 -> B reads 0 on a 2-channel texture -> z = 2*0-1 = -1, i.e. every
                # facet normal points down into the water: the surface goes black everywhere.
                # Octahedral is therefore the only encoding this texture can use. The pack never
                # wrote this input, so it is pinned here to make the decode explicit.
                int inputs:encoding = 0 (
                    customData = {
                        int default = 0
                    }
                    displayGroup = "Normal"
                    displayName = "Normal Map Encoding"
                    doc = """Encoding type for the normal map.  Octahedral for 2 channel textures. tangent_space_dx for 3 channel normals, and tangent_space_ogl for 3 channel normals with an inverted (OpenGL style) G channel.

"""
                    hidden = true
                )
            }
        }

        over "mat_A75A0B41F2454F04"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @../../materials/AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
