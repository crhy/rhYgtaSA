# s02/s32/n07 water: this is the runtime's only normal-strength knob (tooltip: "An arbitrary
# strength scale factor to apply when decoding normals in the translucent material. Should only be
# used for debugging or development."), and it multiplies whatever the normal map does.
#   1.0  with the regenerated sheets ('remix-ref' 6 deg median tilt, 'soft' 12 deg) - the map
#        already carries the softening; this is the shipped pairing.
#   0.35 with the pack's own water_normal.dds ('realistic'/'calm'): the pack sheet decodes to a 44-46
#        deg median facet tilt and 0.35 brings it to ~12 deg (measured, .strata/notes-s02-water.md).
# Both numbers are kept here so the A/B is one line, but they belong to different variants: 0.35 on
# top of 'remix-ref' is ~2 deg, i.e. glass.
rtx.translucentMaterial.normalIntensity = 1.0


# ---------------------------------------------------------------------------
# n04 (2026-11-12b test, finding A, top priority): a light must never depend on
# which way the camera is pointing, and must never pop with distance.
#
# What the 1.6.1 source says, measured rather than guessed
# (build/tmp/s18/dxvk-remix-remix-1.6.1/src/dxvk/rtx_render/, quoted in
# .strata/notes-n04-lights-always-on.md):
#   * A light made through the C API is never frustum-culled. LightManager marks
#     inside/outside frustum only for its own game-detected lights
#     (rtx_light_manager.cpp:151-183) and garbage-collects only those
#     (:110-141); API lights live in m_externalLights and disappear only on
#     DestroyLight (:795-810). Their per-frame presence is DrawLightInstance
#     (:857-865), which the plugin does every frame for every lamp it holds.
#     So "off-screen lights still light" is already true for our lamps: what is
#     view-dependent is not their existence but whether a pixel ever draws one.
#   * With rtx.di.initialSampleCount = 4 (default) and the 401 live lights the
#     2026-11-12 10:22 run measured, each pixel draws 4 random candidates out of
#     401 for direct light - about a 1% lottery per lamp per frame, held together
#     by reuse with rtx.di.maxHistoryLength = 4 frames. Rotate the camera, the
#     reservoirs are discarded, and the lamps have to be re-found by the lottery:
#     that is "lights flicker in and out of existence when the camera rotates".
#     The same lottery runs for indirect rays (rtx.risLightSampleCount = 7) and
#     for volumetrics (initialRISSampleCount = 32, reservoir clamped to
#     temporalReuseMaxSampleCount = 2).
# So the pool got bigger (the plugin now keeps every lamp inside max_distance
# alive instead of letting the cap evict it) and the sampling has to keep up.
# These are the keys that do that. rtx.localtonemap.shadows, the tonemap, the
# texture lists and every other look key are untouched.
rtx.di.initialSampleCount = 8
#   "The number of lights randomly selected from the global pool to consider when
#    selecting a light with RTXDI. Higher values generally increases the quality
#    of RIS light sampling, but also has diminishing returns and higher
#    performance cost past a point." 4 -> 8 doubles the direct-light candidate
#    draw; it is the price of a 400-550 lamp pool, and the pair has to move
#    together (see [streetlights] max_lights in rhyremix.ini).
rtx.di.maxHistoryLength = 12
#   "Maximum age of reservoirs for temporal reuse." 4 -> 12: a lamp's direct
#   light survives ~12 frames of reuse instead of 4, so a camera rotation stops
#   re-drawing the whole street.
rtx.risLightSampleCount = 16
#   "The number of lights randomly selected from the global pool to consider when
#    selecting a light with RIS ... RIS is only used when RTXDI is disabled for
#    direct lighting, or for light sampling in indirect rays." 7 -> 16: this is
#    the layer that decides whether a lamp contributes to GI and reflections at
#    all, and finding D ("the pier bulbs have no illumination") is a symptom of
#    drawing 7 of 400.
rtx.volumetrics.temporalReuseMaxSampleCount = 8
#   "The number of samples to clamp temporal reservoirs to, should usually be
#    around the value: desired_max_history_frames * average_reservoir_samples."
#   2 -> 8: at 2 the volumetric glow of a lamp is carried by two samples, which
#   is why light shafts boil and re-appear when the camera moves.
rtx.volumetrics.restirGridGuardBandFactor = 1.5
#   "The scale factor for the restir grid guard band, which is an extended part
#    of the viewing frustum for which we should calculate lighting information
#    for, even though they are technically offscreen. This helps reduce noise in
#    cases where the camera is moving around." 1.1 -> 1.5: the runtime's own
#    answer to view-direction dependence, for the froxel/ReSTIR volumetric grid.
rtx.antiCulling.object = True
#   "Extends lifetime of objects that go outside the camera frustum (anti-culling
#    frustum)." Off by default. This is about the GEOMETRY: a lamp post, a sign
#    gantry or a pier railing that leaves the frustum leaves the TLAS, so a
#    visibility ray to an off-screen lamp passes through it and the light leaks
#   (and the post itself pops). Costs TLAS memory, not shaders.
rtx.antiCulling.light = True
#   "Enable Anti-Culling for lights." Off by default. It applies to the game's
#   own converted lights (rtx.enableReplacementLights is True and
#   rtx.ignoreGamePointLights is False, so the game's lights are in the runtime's
#   light table and are garbage-collected by the frustum rule), not to the API
#   lights this plugin makes - those are already never culled.
rtx.antiCulling.light.numFramesToExtendLightLifetime = 1000
#   "Maximum number of frames to keep when Anti-Culling is enabled. Make sure not
#    to set this too low (then the anti-culling won't work), nor too high (which
#    will hurt the performance)." Written out at its default so the A/B is pinned
#    and nobody re-invents it; 1000 frames is ~16 s at 60 fps.
#
# NOT set here, with the reason:
#   rtx.antiCulling.object.enableInfinityFarFrustum (default False) - an infinite
#     far plane keeps the whole city in the TLAS. On this map that is a VRAM and
#     BLAS cost we have not measured; try it in the Remix UI before shipping it.
#   rtx.antiCulling.object.farPlaneScale (default 10) / fovScale (default 1) -
#     the cheaper way to widen the same frustum, left at the defaults.
#   rtx.enableCulling - s28 called this the frustum switch. It is not: its
#     tooltip is "Enable front/backface culling for opaque objects". Left False.
#   rtx.uniqueObjectDistance - s28 called this a light/object distance. It is
#     "the distance an object can move in a single frame before it is no longer
#     considered the same object", default 300, and our objects do not move.


# ---------------------------------------------------------------------------
# n07 (2026-11-12b findings F and H): water, the way the other RTX Remix projects do it.
# Research log with every URL: .strata/notes-n07-water-research.md. The short version: every
# project surveyed (NVIDIA's own Path-traced Minecraft mod, xoxor4d's GTA IV / Portal 2 RTX,
# gta2-rtx-remix) puts its water in the runtime's AnimatedWater category and lets the runtime
# animate it, and the two of them that ship water normals generate them (octahedral R/G, BC5, full
# mip chain, calm slopes) instead of repairing the original - which is what tools/water.sh
# remix-ref now does. Paired with config/water/remix-ref.usda.
#
# The category is the precondition for all of it: translucent_surface_material_interaction.slangh:62
# gates the whole water path on `animatedWaterEnable && surface.isAnimatedWater`, and lines 73-83
# show what that buys - the sprite-sheet frame's UV is scrolled by
# `time * animatedWaterPrimaryNormalMotion` and the normal map is sampled a SECOND time at
# `animatedWaterSecondaryNormalLodBias`, i.e. the runtime's own low-frequency wave layer.
# 0x59296793798A7318 (the sea texture the game generates) has been in rtx.animatedWaterTextures
# all along; 0xA75A0B41F2454F04 (the game's waterclear256, the other water material) was not, so
# none of this ever ran on that surface. Both are in the list above now.
rtx.translucentMaterial.animatedWaterEnable = True
#   Default True, written out so the A/B is pinned. NFSU2-RTX-Remix ships the opposite for the
#   opaque side (rtx.opaqueMaterial.layeredWaterNormalEnable = False), so this is a real fork in
#   the road, not a free default.
rtx.translucentMaterial.animatedWaterSecondaryNormalLodBias = 2.0
#   Tooltip: "LoD bias to use when taking the second normal map sample. Values greater than 0 will
#   cause the secondary normal map to be blurred, resulting in lower frequency waves." Default 1;
#   2 because our sheet is now calm and the second layer is where the long swell should come from.
rtx.opaqueMaterial.layeredWaterNormalEnable = True
#   Default True; pinned because the docs' Animated Water entry names it ("...only when
#   rtx.opaqueMaterial.layeredWaterNormalEnable is set to true") and any water draw the runtime
#   classifies as opaque needs it.
rtx.rayreconstruction.invalidateHistoryForAnimatedWater = False
#   Tooltip (rtx_ray_reconstruction.h:77): "Adds animated water surfaces to the disocclusion mask,
#   making DLSS Ray Reconstruction discard their temporal history every frame ... can introduce
#   shimmering on objects seen through or near the water, so it is disabled by default." With the
#   regenerated sheet the surface no longer re-randomises per frame (|grad tilt| 21.3 -> 1.0
#   deg/texel), so keeping history is the right side of that trade; set True if the sea ever
#   smears when the camera moves.
rtx.rayreconstruction.combineSpecularAlbedo = True
#   NVIDIA's own rtx.conf for the Path-traced Minecraft Remix mod, verbatim reason: "DLSS-RR needs
#   the combined primary and secondary specular albedo to reconstruct water reflections: without
#   it, shaded water reflects blotchy sky-coloured smears instead of the scene." That is finding F's
#   "water still looks bad" under a denoiser. Cost: cloud reflections blur the refraction signal.
rtx.enableDirectTranslucentShadows = True
#   Tooltip: "Calculate coloured shadows for translucent materials (i.e. glass, water) in direct
#   lighting." Default False; NVIDIA's Minecraft mod and NFSU2-RTX-Remix both ship True, GTA IV RTX
#   and Portal 2 RTX ship False. It is the cheap half of the pair (primary visibility rays only);
#   rtx.enableIndirectTranslucentShadows (reflections/GI) is deliberately NOT set - that is the one
#   the two GTA-scale projects refuse, and finding G is about frame-time steadiness.
rtx.volumetrics.enableTranslucentShadows = True
#   "Let volumetric lighting pass through translucent surfaces (water, glass)" - NVIDIA's comment
#   for the same line in the Minecraft profile. Volumetric lighting is on in this profile, so this
#   is what keeps a light cone alive where it crosses the sea surface.
#
# NOT set, with the reason (all measured against config/rtx-runtime-keys.txt, i.e. our 1.6.1 dll):
#   rtx.water.shoreFadeEnable / shoreCutDepth / shoreFadeWidth / shoreFadeDistance /
#   shoreProbeSpread / shoreThinLayer / objectFadeWidth, rtx.atmosphere.waterHorizonFade*Meters -
#     the shoreline fade xoxor4d's GTA IV RTX actually uses (docs/RemixWaterAPI_gta4.md in
#     github.com/xoxor4d/dxvk-remix, branch game/gta4: a downward depth probe, then
#     fade = saturate((depth + slope*shoreHeightScale - shoreCutDepth)/shoreFadeWidth), and at
#     fade 0 the water hit is skipped, which "removes the bright reflection line where water meets
#     the shore and the hard edge"). Those keys are in that FORK's runtime, not in stock 1.6.1 -
#     rtxkeycheck.py reports all of them unknown here, so writing them would be a silent no-op.
#   rtx.spatiallyHashedRadianceCache.queryForThinOpaquePrimaryView /
#   rtx.subsurface.disableThinOpaqueInSecondaryRays - the Minecraft mod's "Reduce SHaRC/NRC shimmer
#     on leaves" block; also unknown in 1.6.1.
#   rtx.forceCutoutAlpha - real in 1.6.1 (default 0.5) but it only applies to the
#     remix_category:alpha_blend_to_cutout category, which has no rtx.conf hash list in this build;
#     our cards are already cutouts through rtx.hairCardTextures, so there is nothing for it to do.


# ---------------------------------------------------------------------------
# n07 foliage: the opacity-micromap guard rails, pinned from the two community profiles that
# survived a scene like ours. The hillside is now 119 alpha-CUTOUT card textures
# (rtx.hairCardTextures above, s32), and cutouts are exactly what opacity micromaps accelerate -
# but this repo already ate an OMM out-of-memory device loss once (docs/VEGETATION.md: "GPU device
# loss came 20 s after '[RTX Opacity Micromap] Out of memory budget'") and the same log line
# "Instance requires more texel taps to resolve opacity than allowed" is in the good run too.
# These four lines are what xoxor4d's GTA IV and Portal 2 RTX profiles carry for that scene type
# (assets/rtx.conf in github.com/xoxor4d/gta4-rtx and github.com/xoxor4d/p2-rtx); measured against
# the 1.6.1 source (src/dxvk/rtx_render/rtx_opacity_micromap_manager.h) most of them are also the
# runtime's own defaults, so this is a pin, not a tune - the point is that the caps our own scar
# refers to are written down and cannot drift.
rtx.opacityMicromap.cache.maxVidmemSizePercentage = 0.15
#   "Budget: Max Video Memory Size %." - the percentage cap that sits next to the MB caps already
#   in this file (maxBudgetSizeMB / minFreeVidmemMBToNotAllocate); both community profiles ship 0.15.
rtx.opacityMicromap.building.conservativeEstimation.maxTexelTapsPerMicroTriangle = 64
#   Source comment, verbatim: "Set to 64 as a safer cap. 512 has been found to cause a timeout.
#   Any micro triangles requiring more texel taps will be tagged as Opaque Unknown." That tag is
#   the sane fallback for a dense grass card; the timeout is the freeze we were chasing in s03.
rtx.opacityMicromap.buildRequests.enableAnimatedInstances = False
#   "Enables Opacity Micromaps for animated instances." Default False, and both profiles write
#   False: SA's foliage is static procobj, so per-frame OMM rebuilds are pure loss.
rtx.opacityMicromap.building.splitBillboardGeometry = True
#   "Splits billboard geometry and corresponding Opacity Micromaps to quads for higher reuse ...
#   Games often batch instanced geometry that reuses same geometry and textures." That is literally
#   what procobj/vegepart grass is, so the reuse win is real here.
#
# The other half of the research answer for foliage, stated rather than shipped:
#   * "two-sided" needs no key in 1.6.1 - rtx_options.h:933: "Enable front/backface culling for
#     opaque objects. Objects with alpha blend or alpha test are not culled", and the hair-card
#     category itself "disable[s] backface culling" (docs Render Categories page).
#   * NVIDIA's Minecraft mod turns OMM OFF ("Keep opacity micromaps disabled for Minecraft's
#     high-volume terrain workload"). That is the A/B for a hillside that still misbehaves, and
#     docs/VEGETATION.md already documents how to take it (tools/vegetation.sh on <game> --step 3).
#   * rtx.vertexColorIsBakedLighting (default True, "brightness contribution will be removed from
#     the vertex color by dividing each component by the largest component") is set False in the
#     Minecraft profile because there vertex colour is grass/leaf TINT, not baked light. SA's
#     procobj cards also carry vertex colour, but we have not measured whether theirs are tint or
#     baked fade, so it is an open item, not a shipped line.


# n01: the live temporal keys the shipped profile never wrote (see the header).
rtx.di.enableTemporalReuse = True
rtx.di.enableTemporalBiasCorrection = True
rtx.spatiallyHashedRadianceCache.maxNumFramesToAccumulate = 16
rtx.volumetrics.maxAccumulationFrames = 16
rtx.temporalAA.newFrameWeight = 0.35
rtx.autoExposure.autoExposureSpeed = 0.5
