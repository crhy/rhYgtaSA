# s02/s32/n07 water: this is the runtime's only normal-strength knob (tooltip: "An arbitrary
# strength scale factor to apply when decoding normals in the translucent material. Should only be
# used for debugging or development."), and it multiplies whatever the normal map does.
#   1.0  with the regenerated sheets ('remix-ref' 6 deg median tilt, 'soft' 12 deg) - the map
#        already carries the softening; this is the shipped pairing.
#   0.35 with the pack's own water_normal.dds ('realistic'/'calm'): the pack sheet decodes to a 44-46
#        deg median facet tilt and 0.35 brings it to ~12 deg (measured, .strata/notes-s02-water.md).
# Both numbers are kept here so the A/B is one line, but they belong to different variants: 0.35 on
# top of 'remix-ref' is ~2 deg, i.e. glass.
rtx.translucentMaterial.normalIntensity = 1.0


# ---------------------------------------------------------------------------
# n04 (2026-11-12b test, finding A, top priority): a light must never depend on
# which way the camera is pointing, and must never pop with distance.
#
# What the 1.6.1 source says, measured rather than guessed
# (build/tmp/s18/dxvk-remix-remix-1.6.1/src/dxvk/rtx_render/, quoted in
# .strata/notes-n04-lights-always-on.md):
#   * A light made through the C API is never frustum-culled. LightManager marks
#     inside/outside frustum only for its own game-detected lights
#     (rtx_light_manager.cpp:151-183) and garbage-collects only those
#     (:110-141); API lights live in m_externalLights and disappear only on
#     DestroyLight (:795-810). Their per-frame presence is DrawLightInstance
#     (:857-865), which the plugin does every frame for every lamp it holds.
#     So "off-screen lights still light" is already true for our lamps: what is
#     view-dependent is not their existence but whether a pixel ever draws one.
#   * With rtx.di.initialSampleCount = 4 (default) and the 401 live lights the
#     2026-11-12 10:22 run measured, each pixel draws 4 random candidates out of
#     401 for direct light - about a 1% lottery per lamp per frame, held together
#     by reuse with rtx.di.maxHistoryLength = 4 frames. Rotate the camera, the
#     reservoirs are discarded, and the lamps have to be re-found by the lottery:
#     that is "lights flicker in and out of existence when the camera rotates".
#     The same lottery runs for indirect rays (rtx.risLightSampleCount = 7) and
#     for volumetrics (initialRISSampleCount = 32, reservoir clamped to
#     temporalReuseMaxSampleCount = 2).
# So the pool got bigger (the plugin now keeps every lamp inside max_distance
# alive instead of letting the cap evict it) and the sampling has to keep up.
# These are the keys that do that. rtx.localtonemap.shadows, the tonemap, the
# texture lists and every other look key are untouched.
rtx.di.initialSampleCount = 8
#   "The number of lights randomly selected from the global pool to consider when
#    selecting a light with RTXDI. Higher values generally increases the quality
#    of RIS light sampling, but also has diminishing returns and higher
#    performance cost past a point." 4 -> 8 doubles the direct-light candidate
#    draw; it is the price of a 400-550 lamp pool, and the pair has to move
#    together (see [streetlights] max_lights in rhyremix.ini).
rtx.di.maxHistoryLength = 12
#   "Maximum age of reservoirs for temporal reuse." 4 -> 12: a lamp's direct
#   light survives ~12 frames of reuse instead of 4, so a camera rotation stops
#   re-drawing the whole street.
rtx.risLightSampleCount = 16
#   "The number of lights randomly selected from the global pool to consider when
#    selecting a light with RIS ... RIS is only used when RTXDI is disabled for
#    direct lighting, or for light sampling in indirect rays." 7 -> 16: this is
#    the layer that decides whether a lamp contributes to GI and reflections at
#    all, and finding D ("the pier bulbs have no illumination") is a symptom of
#    drawing 7 of 400.
rtx.volumetrics.temporalReuseMaxSampleCount = 8
#   "The number of samples to clamp temporal reservoirs to, should usually be
#    around the value: desired_max_history_frames * average_reservoir_samples."
#   2 -> 8: at 2 the volumetric glow of a lamp is carried by two samples, which
#   is why light shafts boil and re-appear when the camera moves.
rtx.volumetrics.restirGridGuardBandFactor = 1.5
#   "The scale factor for the restir grid guard band, which is an extended part
#    of the viewing frustum for which we should calculate lighting information
#    for, even though they are technically offscreen. This helps reduce noise in
#    cases where the camera is moving around." 1.1 -> 1.5: the runtime's own
#    answer to view-direction dependence, for the froxel/ReSTIR volumetric grid.
# n16 audit: DEAD NAME. The option is rtx.antiCulling.object.enable (default False), so this
# line and the one under it have never run - the anti-culling frustum is still off. The intent
# below is right, the name is not; renaming them makes them live and that is a TLAS/VRAM
# decision (numObjectsToKeep default 10000), not a look one, so it belongs to a perf task.
# docs/FINDINGS.md, "Dead keys".
rtx.antiCulling.object = True
#   "Extends lifetime of objects that go outside the camera frustum (anti-culling
#    frustum)." Off by default. This is about the GEOMETRY: a lamp post, a sign
#    gantry or a pier railing that leaves the frustum leaves the TLAS, so a
#    visibility ray to an off-screen lamp passes through it and the light leaks
#   (and the post itself pops). Costs TLAS memory, not shaders.
# n16 audit: DEAD NAME, see above - the option is rtx.antiCulling.light.enable (default False).
rtx.antiCulling.light = True
#   "Enable Anti-Culling for lights." Off by default. It applies to the game's
#   own converted lights (rtx.enableReplacementLights is True and
#   rtx.ignoreGamePointLights is False, so the game's lights are in the runtime's
#   light table and are garbage-collected by the frustum rule), not to the API
#   lights this plugin makes - those are already never culled.
rtx.antiCulling.light.numFramesToExtendLightLifetime = 1000
#   "Maximum number of frames to keep when Anti-Culling is enabled. Make sure not
#    to set this too low (then the anti-culling won't work), nor too high (which
#    will hurt the performance)." Written out at its default so the A/B is pinned
#    and nobody re-invents it; 1000 frames is ~16 s at 60 fps.
#
# NOT set here, with the reason:
#   rtx.antiCulling.object.enableInfinityFarFrustum (default False) - an infinite
#     far plane keeps the whole city in the TLAS. On this map that is a VRAM and
#     BLAS cost we have not measured; try it in the Remix UI before shipping it.
#   rtx.antiCulling.object.farPlaneScale (default 10) / fovScale (default 1) -
#     the cheaper way to widen the same frustum, left at the defaults.
#   rtx.enableCulling - s28 called this the frustum switch. It is not: its
#     tooltip is "Enable front/backface culling for opaque objects". Left False.
#   rtx.uniqueObjectDistance - s28 called this a light/object distance. It is
#     "the distance an object can move in a single frame before it is no longer
#     considered the same object", default 300, and our objects do not move.


# ---------------------------------------------------------------------------
# n07 (2026-11-12b findings F and H): water, the way the other RTX Remix projects do it.
# Research log with every URL: .strata/notes-n07-water-research.md. The short version: every
# project surveyed (NVIDIA's own Path-traced Minecraft mod, xoxor4d's GTA IV / Portal 2 RTX,
# gta2-rtx-remix) puts its water in the runtime's AnimatedWater category and lets the runtime
# animate it, and the two of them that ship water normals generate them (octahedral R/G, BC5, full
# mip chain, calm slopes) instead of repairing the original - which is what tools/water.sh
# remix-ref now does. Paired with config/water/remix-ref.usda.
#
# The category is the precondition for all of it: translucent_surface_material_interaction.slangh:62
# gates the whole water path on `animatedWaterEnable && surface.isAnimatedWater`, and lines 73-83
# show what that buys - the sprite-sheet frame's UV is scrolled by
# `time * animatedWaterPrimaryNormalMotion` and the normal map is sampled a SECOND time at
# `animatedWaterSecondaryNormalLodBias`, i.e. the runtime's own low-frequency wave layer.
# 0x59296793798A7318 (the sea texture the game generates) has been in rtx.animatedWaterTextures
# all along; 0xA75A0B41F2454F04 (the game's waterclear256, the other water material) was not, so
# none of this ever ran on that surface. Both are in the list above now.
rtx.translucentMaterial.animatedWaterEnable = True
#   Default True, written out so the A/B is pinned. NFSU2-RTX-Remix ships the opposite for the
#   opaque side (rtx.opaqueMaterial.layeredWaterNormalEnable = False), so this is a real fork in
#   the road, not a free default.
rtx.translucentMaterial.animatedWaterSecondaryNormalLodBias = 2.0
#   Tooltip: "LoD bias to use when taking the second normal map sample. Values greater than 0 will
#   cause the secondary normal map to be blurred, resulting in lower frequency waves." Default 1;
#   2 because our sheet is now calm and the second layer is where the long swell should come from.
rtx.opaqueMaterial.layeredWaterNormalEnable = True
#   Default True; pinned because the docs' Animated Water entry names it ("...only when
#   rtx.opaqueMaterial.layeredWaterNormalEnable is set to true") and any water draw the runtime
#   classifies as opaque needs it.
rtx.rayreconstruction.invalidateHistoryForAnimatedWater = False
#   Tooltip (rtx_ray_reconstruction.h:77): "Adds animated water surfaces to the disocclusion mask,
#   making DLSS Ray Reconstruction discard their temporal history every frame ... can introduce
#   shimmering on objects seen through or near the water, so it is disabled by default." With the
#   regenerated sheet the surface no longer re-randomises per frame (|grad tilt| 21.3 -> 1.0
#   deg/texel), so keeping history is the right side of that trade; set True if the sea ever
#   smears when the camera moves.
rtx.rayreconstruction.combineSpecularAlbedo = True
#   NVIDIA's own rtx.conf for the Path-traced Minecraft Remix mod, verbatim reason: "DLSS-RR needs
#   the combined primary and secondary specular albedo to reconstruct water reflections: without
#   it, shaded water reflects blotchy sky-coloured smears instead of the scene." That is finding F's
#   "water still looks bad" under a denoiser. Cost: cloud reflections blur the refraction signal.
rtx.enableDirectTranslucentShadows = True
#   Tooltip: "Calculate coloured shadows for translucent materials (i.e. glass, water) in direct
#   lighting." Default False; NVIDIA's Minecraft mod and NFSU2-RTX-Remix both ship True, GTA IV RTX
#   and Portal 2 RTX ship False. It is the cheap half of the pair (primary visibility rays only);
#   rtx.enableIndirectTranslucentShadows (reflections/GI) is deliberately NOT set - that is the one
#   the two GTA-scale projects refuse, and finding G is about frame-time steadiness.
rtx.volumetrics.enableTranslucentShadows = True
#   "Let volumetric lighting pass through translucent surfaces (water, glass)" - NVIDIA's comment
#   for the same line in the Minecraft profile. Volumetric lighting is on in this profile, so this
#   is what keeps a light cone alive where it crosses the sea surface.
#
# NOT set, with the reason (all measured against config/rtx-runtime-keys.txt, i.e. our 1.6.1 dll):
#   rtx.water.shoreFadeEnable / shoreCutDepth / shoreFadeWidth / shoreFadeDistance /
#   shoreProbeSpread / shoreThinLayer / objectFadeWidth, rtx.atmosphere.waterHorizonFade*Meters -
#     the shoreline fade xoxor4d's GTA IV RTX actually uses (docs/RemixWaterAPI_gta4.md in
#     github.com/xoxor4d/dxvk-remix, branch game/gta4: a downward depth probe, then
#     fade = saturate((depth + slope*shoreHeightScale - shoreCutDepth)/shoreFadeWidth), and at
#     fade 0 the water hit is skipped, which "removes the bright reflection line where water meets
#     the shore and the hard edge"). Those keys are in that FORK's runtime, not in stock 1.6.1 -
#     rtxkeycheck.py reports all of them unknown here, so writing them would be a silent no-op.
#   rtx.spatiallyHashedRadianceCache.queryForThinOpaquePrimaryView /
#   rtx.subsurface.disableThinOpaqueInSecondaryRays - the Minecraft mod's "Reduce SHaRC/NRC shimmer
#     on leaves" block; also unknown in 1.6.1.
#   rtx.forceCutoutAlpha - real in 1.6.1 (default 0.5) but it only applies to the
#     remix_category:alpha_blend_to_cutout category, which has no rtx.conf hash list in this build;
#     our cards are already cutouts through rtx.hairCardTextures, so there is nothing for it to do.


# ---------------------------------------------------------------------------
# n07 foliage: the opacity-micromap guard rails, pinned from the two community profiles that
# survived a scene like ours. The hillside is now 119 alpha-CUTOUT card textures
# (rtx.hairCardTextures above, s32), and cutouts are exactly what opacity micromaps accelerate -
# but this repo already ate an OMM out-of-memory device loss once (docs/VEGETATION.md: "GPU device
# loss came 20 s after '[RTX Opacity Micromap] Out of memory budget'") and the same log line
# "Instance requires more texel taps to resolve opacity than allowed" is in the good run too.
# These four lines are what xoxor4d's GTA IV and Portal 2 RTX profiles carry for that scene type
# (assets/rtx.conf in github.com/xoxor4d/gta4-rtx and github.com/xoxor4d/p2-rtx); measured against
# the 1.6.1 source (src/dxvk/rtx_render/rtx_opacity_micromap_manager.h) most of them are also the
# runtime's own defaults, so this is a pin, not a tune - the point is that the caps our own scar
# refers to are written down and cannot drift.
rtx.opacityMicromap.cache.maxVidmemSizePercentage = 0.15
#   "Budget: Max Video Memory Size %." - the percentage cap that sits next to the MB caps already
#   in this file (maxBudgetSizeMB / minFreeVidmemMBToNotAllocate); both community profiles ship 0.15.
rtx.opacityMicromap.building.conservativeEstimation.maxTexelTapsPerMicroTriangle = 64
#   Source comment, verbatim: "Set to 64 as a safer cap. 512 has been found to cause a timeout.
#   Any micro triangles requiring more texel taps will be tagged as Opaque Unknown." That tag is
#   the sane fallback for a dense grass card; the timeout is the freeze we were chasing in s03.
rtx.opacityMicromap.buildRequests.enableAnimatedInstances = False
#   "Enables Opacity Micromaps for animated instances." Default False, and both profiles write
#   False: SA's foliage is static procobj, so per-frame OMM rebuilds are pure loss.
rtx.opacityMicromap.building.splitBillboardGeometry = True
#   "Splits billboard geometry and corresponding Opacity Micromaps to quads for higher reuse ...
#   Games often batch instanced geometry that reuses same geometry and textures." That is literally
#   what procobj/vegepart grass is, so the reuse win is real here.
#
# The other half of the research answer for foliage, stated rather than shipped:
#   * "two-sided" needs no key in 1.6.1 - rtx_options.h:933: "Enable front/backface culling for
#     opaque objects. Objects with alpha blend or alpha test are not culled", and the hair-card
#     category itself "disable[s] backface culling" (docs Render Categories page).
#   * NVIDIA's Minecraft mod turns OMM OFF ("Keep opacity micromaps disabled for Minecraft's
#     high-volume terrain workload"). That is the A/B for a hillside that still misbehaves, and
#     docs/VEGETATION.md already documents how to take it (tools/vegetation.sh on <game> --step 3).
#   * rtx.vertexColorIsBakedLighting (default True, "brightness contribution will be removed from
#     the vertex color by dividing each component by the largest component") is set False in the
#     Minecraft profile because there vertex colour is grass/leaf TINT, not baked light. SA's
#     procobj cards also carry vertex colour, but we have not measured whether theirs are tint or
#     baked fade, so it is an open item, not a shipped line.

# ---------------------------------------------------------------------------
# n16 (2026-11-13, docs/TARGET.md §4 T4): the daytime frame has no bright end.
# Measured before (tools/target-gap.py, build/tmp/n15/gap.json, 640x360 + JPEG q72): our four
# daytime shots sit at headroom p99.9/p50 = 1.41-1.81 with ceiling pixels (luma >= 252) at
# 0.003-0.027 % of the frame, where the five reference frames are 1.79-3.49 and 0.01-3.95 %;
# our p50 is 123-170 where theirs is 65-142. Notes with every number:
# .strata/notes-n16-tonemap-highlights.md.
#
# Every key below was checked with tools/rtx-option-audit.py against config/rtx-options-1.6.1.tsv,
# the runtime's OWN option table (RtxOptions.md at the remix-1.6.1 tag, auto-generated by Remix
# itself, MIT, upstream github.com/NVIDIAGameWorks/dxvk-remix). That tool exists because the older
# audit in this repo (tools/rtxkeycheck.py, a `strings` check) accepts rtx.tonemap.tonemappingMode
# - the name the task file used - while the option is rtx.tonemappingMode: rtx_option.h:267 builds
# the config name as category + "." + name, and the declaration is
# RTX_OPTION("rtx", TonemappingMode, tonemappingMode, TonemappingMode::Local, ...) at
# rtx_options.h:1181. A key that names no option is kept in the file and ignored
# (rtx_option_layer.cpp:416-421), so the task's spelling would have made this whole change do
# nothing, silently.
rtx.tonemappingMode = 0
#   "The tonemapping type to use, 0 for Global, 1 for Local (Default). ... Local tonemapping ...
#   uses spatially-local parameters determined by regions of the rendered image rather than the
#   whole image." Default 1 = Local, and Local is exactly the mechanism docs/FINDINGS.md ("Night
#   realism") names: DxvkLocalToneMapping renders three synthetic exposures (x2^shadows, x1,
#   x2^-highlights - with our 2.5 and the default 4 that is a 90:1 spread), weights them per pixel
#   by a gaussian around 0.5 gamma luminance, mip-averages the pair to rtx.localtonemap.mip = 3
#   and applies the fitted line as ONE multiplier on R, G and B - the runtime's own comment: "a
#   crude multiplier on all RGB channels. This is... generally pretty wrong". A local normalisation
#   toward 0.5 gamma lifts the floor and pulls the ceiling down, and it is re-solved around
#   whatever is in frame (n10's view-dependent exposure; the daytime numbers above are what it does
#   at noon). Global mode instead fits ONE curve to the whole frame's histogram, pins linear 0.18
#   to 0.18, maps the top of the range to white, clamps any lift to rtx.tonemap.maxExposureIncrease
#   (5 stops) and mixes that curve with the previous frame's at exp(-0.07) (~14 frames to settle),
#   so a lighting change converges instead of snapping - which also matters for n01's "no pops" A/B.
#   The graphics-preset layer does not own this key: updateGraphicsPresets (rtx_options.cpp:410-620)
#   writes bounces, denoise, sparse rendering, volumetrics quality, stochastic alpha blend and
#   postFx.enable, and no tonemap key - so with rtx.graphicsPreset = 1 this line is ours.
rtx.tonemap.exposureBias = -0.5
#   "The exposure value to use for the global tonemapper when auto exposure is disabled, or a bias
#   multiplier on top of the auto exposure's calculated exposure value." Default 0, and auto
#   exposure is off in every profile we ship, so this is a hard EV: rtx_tone_mapping.cpp:234 sets
#   exposureFactor = 2^(exposureBias + userEVBias), where userEVBias = (userBrightness - 50)/100 *
#   userBrightnessEVRange (rtx_options.h:1514-1516). -0.5 EV is the anchor that pulls p50 from
#   ~147 toward the 100-130 target while the histogram fit leaves the top of the curve near white.
#   Retune ladder for the next live run: p50 still above 130 -> -0.75, then -1.0; the frame goes
#   muddy (p05 collapses, the night shots lose their floor) -> come back up and use
#   rtx.tonemap.shadowContrast (default 0) instead of the exposure.
#   n22 SUPERSEDES THAT LADDER FOR THE NIGHT END: the plugin now writes this same option at runtime
#   (rhyremix.ini [tonemap]: day_ev -0.5 at full daylight -> night_ev +0.5 at night, blended over
#   solar elevation, <= 0.05 EV/s, plugin/src/exposure.cpp). The user layer it writes outranks this
#   file, so this line is the STARTUP value and the full-daylight value - at a noon stop the effective
#   value is still -0.5 (the same number from two directions), at 21:00 it is +0.5. To put a static
#   number back: [tonemap] apply=0 in rhyremix.ini, then this line is the whole story again.
#   The task's other two candidates, evaluated and NOT shipped:
#     rtx.userBrightness / rtx.userBrightnessEVRange do feed the same EV bias, but their real
#     config names are the doubled rtx.userBrightness.userBrightness and
#     rtx.userBrightnessEVRange.userBrightnessEVRange (category + "." + name again - the short
#     spellings are only the UI's category strings), and both carry RtxOptionFlags::UserSetting:
#     they are the Remix UI's "Brightness" slider, they belong in user.conf, and user.conf sits
#     ABOVE rtx.conf (rtx_option_layer.cpp:386-397 offers to migrate them out of rtx.conf). Trim
#     the slider in game; do not fight it from a profile.
#     rtx.postfx.exposureFraction is not an exposure knob at all - it is the shutter fraction of
#     the post-FX motion blur (rtx_postFx.cpp:127 DragFloat("Exposure Fraction", ...) inside the
#     motion-blur block, :294 postFxArgs.exposureFraction; tooltip "Simulate the camera exposure,
#     the longer exposure will cause stronger motion blur", default 0.4). Shipping it for T4 would
#     have bought blur, not highlights.
rtx.localtonemap.shadows = 1.0
#   "Shadow area strength. Higher values cause brighter shadows." Runtime default 2; this file said
#   2.5 (as the live <game>/rtx.conf still does). INERT while rtx.tonemappingMode = 0, because
#   DxvkLocalToneMapping::isEnabled() is false (rtx_local_tone_mapping.cpp:144) - written so the
#   Local A/B (rtx.tonemappingMode = 1) starts from n05's number instead of the squeeze: 2^1 = x2
#   where 2.5 was x5.66.
rtx.localtonemap.highlights = 2.0
#   "Highlight area strength. Higher values cause darker highlight." Runtime default 4, never set
#   in this repo, so the highlight branch has always run at x2^-4 = x0.0625 - a 90:1 spread against
#   shadows. Also inert while mode = 0; in the Local A/B the pair becomes 2^1 : 2^-2 = 8:1, which
#   is the knob n05 parked at 1.5 (docs/FINDINGS.md, "Night realism").
#
# NOT changed, with the reason:
#   rtx.tonemap.finalizeWithACES = True (already in this file; runtime default False). In Local
#     mode it was inert - the local pass has its own rtx.localtonemap.finalizeWithACES, default
#     True - so switching to Global newly turns it on: the apply pass runs ACESFilm over the fitted
#     curve (tonemapping_apply_tonemapping.comp.slang). That is the filmic shoulder we want, and
#     the task requires keeping it.
#   rtx.useLegacyACES (default True) - "Use a luminance-only approximation of ACES that
#     over-saturates the highlights." It now decides WHICH ACES runs. Untouched on purpose: two
#     unmeasured changes at once is how a grading task ends up blaming the wrong knob. It is the
#     first A/B if the sun and chrome come out posterised.
#   rtx.autoExposure.enabled = False (kept). With Global mode and auto exposure off the exposure is
#     one fixed number, so the frame stops re-exposing when the camera turns.
#   rtx.tonemap.dynamicRange (15) / toneCurveMaxStops (8) / toneCurveMinStops (-24) /
#   maxExposureIncrease (5) / curveShift (0) / shadowContrast (0) / shadowMinSlope (0) - the shape
#   of the curve. All left at their defaults: they are the ladder behind the Remix UI's "Tuning
#   Mode" checkbox and not one of them has a measurement behind it yet.
#
# MEASURED OR NOT, stated plainly: this task could not render - the header's rule 1 forbids running
# the game, wine or Steam, and a tonemap change only becomes a number once the runtime draws a
# frame. The keys, their defaults and the mechanism above are measured (the runtime's own table and
# source); the DIRECTION of each knob is derived from that source; the after-numbers are owed by the
# next live run, whose exact command is docs/TARGET.md §6. The before side is recorded in
# build/tmp/n16/gap.json and in the notes, including the shots the 2026-11-12 report called good.
# Undo: tools/rtxprofile.sh current <game>, or delete these five lines.


# ---------------------------------------------------------------------------
# n17 (2026-11-13, docs/TARGET.md §3 T3): distance must fade. GTA SA's fixed-function fog,
# remapped onto the Remix volumetric medium. Six keys, one mechanism, no rays added.
#
# WHAT THE GAME ACTUALLY DRAWS (measured, not assumed)
#   data/timecyc.dat - the pack's own cycle ("Custom Time Cycle for RTX-Remix only created By
#   Discord Hemry", 2026-11-09), column 28 FarClp / column 29 FogSt, 8 rows per weather type:
#   FarClp is 4000 m for every type except the 5 AM EXTRASUNNY_SMOG_LA row (800 m), and FogSt runs
#   -200 m (FOGGY_SF) to +200 m (EXTRASUNNY_VEGAS). The tour pins weather 1 = SUNNY_LA
#   (moonloader/SARemix_Tour.lua:180 forceWeatherNow(1)), whose daytime rows are FarClp 4000 /
#   FogSt 100 m. Vanilla data/timecycp.dat uses FarClp 400-1150 m instead.
#   The runtime reads that as D3D9 render states (d3d9_rtx_utils.cpp:227 setFogState: end =
#   D3DRS_FOGEND, scale = 1/(end-start), colour = D3DRS_FOGCOLOR), i.e. the 4000 m is the number
#   the remap consumes. Our plugin never touches any of it: main.cpp hooks only Present and
#   SetGammaRamp, and tod.h states that the plugin's weather is ini-only ("there is no verified
#   offset for the game's CWeather").
#
# WHY THERE IS NO AERIAL PERSPECTIVE TODAY (the mechanism behind n15's far/near 1.22-3.67)
#   rtx.enableFog (default True) re-applies the captured fog as a depth-based post-effect
#   (rtx_composite.cpp:406-421, composite/comp.slang:648 applyFog) - but applyFog returns
#   immediately when volumetrics are on: "if (cb.volumeArgs.enable) return 1.0f; // Volumetric fog
#   is applied in volume integration" (composite.comp.slang:653), and volumeArgs.enable is
#   enable() && canUsePhysicalFog with rtx.volumetrics.enable default True
#   (rtx_global_volumetrics.cpp:576; the density test at :435-452 passes for any linear fog SA
#   sets). So the game's fog is DISCARDED, and the medium that replaces it is the untouched default
#   transmittanceColor 0.999 measured at transmittanceMeasurementDistanceMeters 200:
#   sigma = -ln(0.9977)/200 = 1.1e-5 /m = 344 km of air. Nothing fades.
#
# THE SIX KEYS, and the arithmetic that picked the numbers (tools/fog-budget.py re-derives every
# figure below from this file; docs/FINDINGS.md "Aerial perspective" has the table):
#   normalized = (fogEnd - MaxDistanceMin) / (MaxDistanceMax - MaxDistanceMin)
#   d_meas     = normalized * (TransMax - TransMin) + TransMin        # NOT clamped by the runtime
#   sigma      = -ln(linear(transmittanceColor)) / d_meas ;  T(x) = exp(-sigma x)
#   visibility = 3.912 / sigma (Koschmieder - the unit that means something)
# Bounds are METRES and SA's world is metres: the runtime multiplies them by
# getMeterToWorldUnitScale() = 100 * rtx.sceneScale (rtx_options.h:1473) and this file's
# rtx.sceneScale = 0.01 makes that scale exactly 1.0.
rtx.volumetrics.enableFogRemap = True
#   The switch. Runtime default False; "Only takes effect when volumetrics are enabled" - and they
#   are (rtx.volumetrics.enable default True, set explicitly in config/rtx.conf.perf).
#   NOT settable at runtime: plugin/src/rtxconf.cpp refuses every "volumetrics." key (kUnsafeKeys +
#   the namespace rule at :245-252) because pushing the volumetric subsystem mid-run killed the
#   bridge server (0xe06d7363) on 2026-11-11. That is why this is a startup file, and why a
#   day/night version of it cannot be a plugin push (see the ladder at the bottom).
rtx.volumetrics.fogRemapMaxDistanceMinMeters = 400
rtx.volumetrics.fogRemapMaxDistanceMaxMeters = 4000
#   The INPUT bounds: they bracket the game's own fog end, not the runtime's defaults (1 / 40 m,
#   which are sized for a corridor game). With the defaults the arithmetic is
#   normalized = (4000 - 1) / 39 = 102 and d_meas = 102 * 80 + 20 = 8200 m - the runtime does not
#   clamp normalized, so the "fog" would be thinner than the default it replaces. 400..4000 covers
#   the live timecycle (4000 m everywhere, 800 m at 5 AM smog) and the vanilla file (400-1150 m).
rtx.volumetrics.fogRemapTransmittanceMeasurementDistanceMinMeters = 2
rtx.volumetrics.fogRemapTransmittanceMeasurementDistanceMaxMeters = 6
#   The OUTPUT bounds, i.e. the density. With transmittanceColor left at its near-white default
#   (-ln(linear 0.999) = 0.002276):
#     fog end 4000 m (clear, every daytime row) -> d_meas 6.0 m -> sigma 3.79e-4 /m -> 10.3 km
#     fog end 1500 m                            -> d_meas 3.2 m -> sigma 7.06e-4 /m ->  5.5 km
#     fog end  800 m (5 AM smog)                -> d_meas 2.4 m -> sigma 9.31e-4 /m ->  4.2 km
#     fog end  400 m (the densest the game asks for) -> d_meas 2.0 m -> 1.14e-3 /m ->  3.4 km
#   At the shipped clear-weather value the transmittance is 0.981 at 50 m, 0.963 at 100 m, 0.827 at
#   500 m, 0.684 at 1 km, 0.468 at 2 km: the skyline loses a third to a half of its contrast while
#   the ground under the camera keeps 98 %. That last number is the task's "haze must not blur the
#   ground under the camera" written as arithmetic - the near band (<= 50 m) cannot lose more than
#   2 % in clear weather, or 5.5 % at the densest fog setting the game can ask for, at any hour,
#   because a homogeneous Beer-Lambert medium only bites at hundreds of metres.
#
#   THE PRICE, stated before anyone measures it: the same exponential attenuates the SKY. SA's sky is
#   tagged (rtx.skyBoxTextures, line 51) and the composite multiplies sky by the volume's
#   transmittance (composite.comp.slang:627-636), so at these bounds the skybox - drawn at the far
#   clip, 4000 m - arrives at 0.219 of its radiance instead of today's 0.956. A denser medium makes
#   the distance fade better and the sky worse; nothing in 1.6.1 pays for that, because the volume's
#   in-scatter only exists inside froxelMaxDistanceMeters (20 m) plus the ambient term this block
#   sets to 0. That is why docs/TARGET.md's haze row and its sky row cannot both be closed by this
#   block, and why the ladder below runs in both directions.
#
# DELIBERATELY NOT SHIPPED, with the reason:
#   rtx.volumetrics.enableFogColorRemap (default False). It replaces the transmittance colour with
#     the game's fog colour, and sigma is -ln(colour)/d_meas: at d_meas 6 m a mid-grey fog colour
#     (0.6 sRGB) gives sigma 0.19 /m and a dark one (0.1) 0.77 /m - transmittance at 50 m would be
#     1e-9, i.e. the street vanishes. The colour of SA's fog also changes with the hour, so this
#     knob is a density knob wearing a colour mask. If someone wants coloured haze, the safe route
#     is a fixed bluish transmittanceColor plus a re-derived d_meas (tools/fog-budget.py --color).
#   rtx.volumetrics.fogRemapColorMultiscatteringScale is NOT left at its default - it ships as 0,
#     two lines below, and the reason is there rather than here.
#   rtx.volumetrics.enableHeterogeneousFog (default False) - commented out, one knob per step:
# rtx.volumetrics.enableHeterogeneousFog = True
#     "Enables a noise-driven heterogeneous fog approximation." Its field is sampled inside the
#     froxel march (composite.comp.slang:390 sampleDensityField), and the noise defaults are sized
#     for a room, not a state: noiseFieldInitialFrequencyPerMeter 8 (12 cm cells),
#     noiseFieldSubStepSizeMeters 10, noiseFieldOctaves 2. At SA's scale that is noise at the
#     froxel-grid limit, not weather. To try it, the starting point is
#     noiseFieldInitialFrequencyPerMeter ~0.002 (500 m cells), noiseFieldSubStepSizeMeters 50,
#     noiseFieldOctaves 3, noiseFieldDensityScale 1 - and it must be measured on its own, because
#     it multiplies the density the six keys above set. The helper that reads the field
#     (rtx/algorithm/volume_composite_helpers.slangh) is not in the public 1.6.1 tarball
#     (raw.githubusercontent ... -> 404), so its exact math cannot be audited offline.
#   rtx.volumetrics.enableAtmosphere and its four parameters: inert in 1.6.1. The C++ fills them in
#     (rtx_global_volumetrics.cpp:618-625) but no shader in the tree reads enableAtmosphere,
#     atmosphereHeight, planetCenter, atmosphereRadiusSquared or maxAttenuationDistanceForNoAtmosphere
#     (grep over src/dxvk/shaders: only volume_args.h declares them). Do not spend a session on them.
#   rtx.volumetrics.froxelMaxDistanceMeters (default 20): left alone. It bounds the froxel MARCH,
#     not the medium - integrateVolumetricTransmittance adds an analytic tail for
#     hitDistance - froxelMaxDistance (composite.comp.slang:414-422), so attenuation reaches the
#     real hit distance - but in-scatter from lamps only exists inside 20 m. Raising it is the next
#     knob if the haze needs to glow (light shafts at distance); it is a quality/perf call, not a
#     look one, and it changes the pack's lamp cones.
rtx.volumetrics.fogRemapColorMultiscatteringScale = 0
#   The runtime's own tooltip: "this multiscattering approximation is very basic (just a simple
#   ambient term for now essentially) and may not look very good". It is fogState.color * scale
#   added to the volume (rtx_global_volumetrics.cpp:539) - a constant glow that does not care
#   whether it is noon or midnight, which is exactly the "fog that lights the night" failure this
#   task is told to avoid. 0 keeps the medium single-scattering: extinction always, no ambient.
#
# NIGHT, stated before anyone measures it. The extinction is time-of-day blind (FarClp is 4000 m at
# every hour of the pack's cycle), so distant things will be dimmer at night too; what does follow
# the clock is the in-scatter, because it is driven by rtx.skyBrightness, which plugin/src/sun.cpp:492
# already ramps 1.00 (day) -> 0.02 (night). A real day/night gate is NOT available as a plugin push
# (the volumetrics namespace is refused at runtime, above) and the profiles are perf/quality
# profiles, not day/night ones. The two honest routes are (a) the game's own timecycle - write
# FarClp per hour into data/timecyc.dat and the remap follows the clock with no plugin involvement
# (a follow-up task, it is a data-pack change and apply.sh territory), or (b) lift the volumetrics
# runtime guard, which is a bridge-stability decision and not this task's to make.
#
# THE LADDER for the live run (docs/TARGET.md §6), one line at a time, re-measure with
#   python3 tools/target-gap.py <ref frames> <daytime shots> --json build/tmp/n17/gap.json
#   and re-derive the density with python3 tools/fog-budget.py config/rtx.conf.
#   Predicted far/near local contrast for pershing-noon (before 3.67; build/tmp/n17/predicted.txt
#   has the whole table): 2.6 with the far band at 1 km, 1.8 at 2 km. The 0.5-0.9 target needs
#   TransMax 2-3 m (3.4-5.2 km of air, SA's foggy end), and it also needs the near band to stop
#   being featureless flat ground - the ratio has two sides and fog only moves one.
#   1. far band still too crisp: TransMax 6 -> 4 (6.9 km) -> 3 (5.2 km) -> 2 (3.4 km). Near-band
#      cost at 50 m goes 0.981 -> 0.972 -> 0.963 -> 0.945, so this knob stays safe for the ground
#      under the camera all the way down; the cost is the sky (0.219 -> 0.103 at 4000 m).
#   2. sky too dark / night washed: TransMax 6 -> 12 (20.6 km) -> 20 (34 km), then
#      rtx.volumetrics.enableFogRemap = False for a clean A/B. The ambient term is already 0, so
#      there is no glow to turn off first - the density is the only knob.
#   3. haze reads grey instead of blue, or the distance needs to GLOW: that is in-scatter, not
#      extinction. The knob is rtx.volumetrics.froxelMaxDistanceMeters (20 m -> 200-1000 m: the
#      grid's memory does not change, its cells get coarser), and colour means a fixed
#      transmittanceColor with d_meas re-derived - never enableFogColorRemap.
#   Undo all of it: delete the six live keys of this block (enableFogRemap, the two MaxDistance
#   bounds, the two transmittance bounds, fogRemapColorMultiscatteringScale). The
#   rtx.volumetrics.enableFogMaxDistanceRemap = True line near the top of this file can stay: it is
#   the runtime default, it only names the switch the remap needs, and with enableFogRemap gone it
#   does nothing. Or tools/rtxprofile.sh current <game>.
#
# MEASURED OR NOT, stated plainly: the keys, their defaults, the mechanism and the density
# arithmetic are measured (the runtime's own option table, its source, and the game's own
# timecycle). The BEFORE numbers are measured (build/tmp/n17/gap.json: far/near local contrast
# 1.22-3.67, sky luma 92-128 at saturation 0.28-0.61). The AFTER numbers are not: rule 1 forbids
# running the game, wine or Steam, and a fog change only becomes a number once the runtime draws a
# frame. The predicted direction is derived from the source above; the after-measurement belongs to
# the next live run, whose command is docs/TARGET.md §6.


# ---------------------------------------------------------------------------
# n18 (2026-11-13, docs/TARGET.md §4 T1a): the materials the pack never touched get a BRDF.
#
# WHAT THE PACK ACTUALLY COVERS, measured read-only in <game>/rtx-remix/mods/gameReadyAssets with
# tools/pack_pbr_census.py (full output build/tmp/n18/census.txt, machine-readable
# build/tmp/n18/census.json). 5211 files, 2111 .dds, 3065 .usda/.usd:
#   * **2363** distinct `mat_<HASH>` materials are named in the pack's USD layers. n15's notes say
#     2334: that count came from `grep -rhoE 'mat_[0-9A-Fa-f]{16}'`, and grep prints "binary file
#     matches" instead of the matches for the 2174 binary crates, so it silently missed 29.
#   * maps keyed by a `<HASH>` (i.e. bound to a *game* texture): **174 albedo, 147 normal,
#     121 rough, 71 height, 13 metal**, 37 emissive. The other maps are 724 hand-named files that
#     belong to the pack's own new geometry (rail_base_albedo.dds, SpotLight_01_albedo.dds ...) and
#     778 bare `<HASH>.dds` copies of the game's own un-remastered textures.
#   * so ~7 % of the materials have a replacement albedo and **~2190 are "legacy"**: the runtime
#     builds them from its own defaults and nothing else. That is the mechanical reason a daytime
#     frame reads as one flat matte sheet next to the reference's glossy-patch-next-to-matte-tile
#     paving (docs/TARGET.md §3), and it is why the fix has to start with the defaults.
#   * the runtime resolves the pack's mixed-case USD paths case-insensitively under Proton
#     (18 of Materials.usda's 23 subLayers say texture/Asphalt/... against an on-disk
#     texture/asphalt/ and still load - notes-n20 read the same fact out of the bridge log), so
#     this is not a bug to fix; it is why tools/pack_pbr_census.py lowercases every category.
#
# WHAT THE PACK'S OWN MAPS SAY, decoded (mip 0, every 8th texel; a `_rough` map is raw data, so
# texel/255 IS the perceptual roughness the renderer will use):
#   per-map mean roughness, median over maps **0.582**, p05 0.095, p95 0.861, and inside a single
#   map the spread (p95-p05) is 0.220 at the median - the pack's maps carry real per-texel
#   variation, which is the thing our legacy materials have none of. By category (mean of the
#   per-map means): wall 0.649, asphalt 0.634, pavement 0.607, ground 0.584, buildings 0.503,
#   props 0.419, floor 0.434, metal 0.382, vehicles 0.247, windows 0.060, marble 0.079, carpet
#   0.783, fabric 0.738. The 191 `_height` maps are not decoration: median amplitude (p95-p05) is
#   84/255 and only 3 of 191 are effectively flat. The 32 `_metal` maps average 0.382 where they
#   exist at all.
#   -> the pack's own paving band is **0.58-0.65**, i.e. the runtime's default legacy roughness of
#      **0.7** (config/rtx-options-1.6.1.tsv, the runtime's own option table) is *mattier* than
#      anything the pack authors chose for the same surface classes. That is the number this block
#      moves, and it moves toward the pack, not toward an invented gloss.
#
# WHY A CONSTANT AND NOT A MAP, stated from the source rather than guessed (fetched at tag
# remix-1.6.1, MIT: src/dxvk/rtx_render/rtx_materials.cpp, kept at build/tmp/n18/rtx_materials.cpp).
# `LegacyMaterialData::as()` copies LegacyMaterialDefaults into an OpaqueMaterialData -
# setRoughnessConstant / setMetallicConstant / setAnisotropyConstant / setAlbedoConstant /
# setOpacityConstant - and then adds only the game's colour texture (setAlbedoOpacityTexture), a
# secondary texture, the sampler override and the alpha rules. A legacy material therefore CANNOT
# carry a roughness or normal map: the roughness of those ~2190 materials is one number for the
# whole game, and no rtx.conf key makes it per-texture. Two names that read like they do and do
# not: rtx.demodulate.demodulateRoughness (True, offset 0.1) is a *denoiser front-end* term -
# pass/demodulate/demodulate.comp.slang scales the noisy specular radiance by
# getRoughnessDemodulationFactor(perceptualRoughness, offset) before NRD packing - and
# rtx.rayreconstruction.demodulateRoughness is DLSS-RR only, which does not initialise on this
# prefix ("NVIDIA DLSS-NR support query failed (0xbad00010)"). Neither puts variation in a material.
# So the honest reading of "not uniform" is: take the constant from the pack's own distribution,
# and do NOT touch the 174 textures whose maps already carry the variation. The per-material
# variation itself has to come from the pack's material layer - the offline PBR-ify pass, which
# this task hands the hash list (build/tmp/n18/pack-uncovered.txt).
rtx.legacyMaterial.roughnessConstant = 0.65
#   One step from the runtime default 0.7, landing on the *matte* end of the pack's own paving band
#   (wall 0.649, asphalt 0.634). One step, not the whole distance: the pack's overall median (0.582)
#   and its ground mean (0.584) are the next rung, not this one, because the legacy constant applies
#   to everything at once - roads and walls and interiors and vegetation - and the night shots are
#   the ones a sheen shows up on first (02 p50 17.4, 03 p50 7.0, both with ceiling 0.000 %:
#   build/tmp/n18/good-before.json).
#   What it costs: nothing measurable in rays. Roughness is a GBuffer term; the only place a lower
#   number changes the pipeline is rtx.spatiallyHashedRadianceCache.perceptualRoughnessThreshold
#   (0.4) and rtx.restirGI.virtualSampleRoughnessThreshold (0.2, "surfaces under this are mirrors"),
#   and 0.65 is far above both. It does sharpen the specular lobe, so the denoiser has slightly
#   less to average where the lobe was already narrow.
#   What it must NOT do, and the number that says it failed: the specular row is already ABOVE the
#   reference for the wrong reason (ours 4.0-27.6 permille vs reference 2.9-12.9, because our
#   "bright" pixels are lifted flat sky - docs/TARGET.md §3), so this block is not chasing permille.
#   It is chasing blobs and largest-blob (ours 43-479 / 128-1192 px vs reference 67-213 / 64-324):
#   real, local, near-neutral highlights instead of a lifted sky. If ceiling % goes past 3 at noon,
#   or the night shots gain a sheen, this line is wrong, not the shots.
#
# DELIBERATELY NOT SHIPPED, with the reason:
#   rtx.opaqueMaterial.roughnessScale / .roughnessBias (defaults 1 / 0). These are the only keys
#     that reach BOTH legacy and replaced materials, and that is exactly the problem: they multiply
#     and shift the pack's 121 rough maps too, flattening the one source of variation the pack has
#     (median intra-map spread 0.220). The runtime's own tooltip says "Should only be used for
#     debugging or development." A legacy-only knob exists (the line above); use it.
#   rtx.legacyMaterial.metallicConstant (default 0.1). Measured: only 13 hashes carry a `_metal`
#     map, and where they do the map averages 0.382 - so 0.1 on ~2190 materials is wrong in both
#     directions (too metallic for asphalt, not metallic enough for the pack's real metal). It is
#     also not free to lower: metallic 0.1 with a bright albedo carries real specular energy
#     (F0 = albedo for that fraction), so 0 would make the frame *deader*, which is the opposite of
#     the gap. One value at a time: this task moves roughness; metallic is the next step, and the
#     measurement that decides it is the specular row, not the census.
#   rtx.legacyMaterial.anisotropy (default 0). One number for every legacy material, so it smears
#     the same highlight direction over roads, walls and cars alike. Not a variation source.
#   rtx.legacyMaterial.useAlbedoTextureIfPresent (default True) - leave it True: it is what keeps
#     the game's own colour on those materials. Setting it False would paint ~2190 materials with
#     the flat albedoConstant.
#   rtx.terrainBaker.* - the runtime's own answer to "ground is not one material": the Terrain
#     Baker bakes the game's blended terrain albedos into one texture and gives it its OWN material,
#     with rtx.terrainBaker.material.properties.roughnessConstant (default 0.7),
#     .roughnessAnisotropy (0) and .metallicConstant (0.1), gated by rtx.terrainBaker.enableBaking
#     (default True) and driven by the rtx.terrainTextures hash list. GTA SA does blend ground
#     sectors (two ground textures per world sector), so this is the one place a *second*, per-class
#     legacy roughness exists without touching the pack. Not shipped: it needs the hash list of the
#     game's blended ground textures (a data task over models/gta3.img, tools/remix_texhash.py
#     computes the hashes offline), the baker writes a texture every frame (a VRAM/fps decision),
#     and nothing about it can be verified without a run. Recorded for the next task, with the
#     Toolkit-side half (the pack's own material layer) being the cheaper route.
#
# THE LADDER for the live run (docs/TARGET.md §6), one line at a time, re-measured with
#   python3 tools/target-gap.py <the 5 reference frames> <the 4 daytime shots> \
#       --json build/tmp/n18/gap-after.json
#   and the six good shots against build/tmp/n18/good-before.json BEFORE tuning anything.
#   1. specular blobs / largest blob still below the reference band and the paving still reads as
#      one matte sheet: 0.65 -> 0.62 (the pack's paving mean) -> 0.58 (the pack's overall median and
#      its ground mean). Re-measure after each; the ceiling row is the brake.
#   2. night shots gain a sheen (02/03 ceiling above 0.000 %, or the sodium lamps start reading on
#      the road): back to 0.7, and the change belongs in the pack's material layer instead - which
#      is the PBR-ify pass, not this file.
#   3. roads look wet but walls/roofs/vegetation look wrong: that is the uniformity, not the value.
#      There is no per-texture legacy knob (source, above); the fix is per-material roughness in a
#      replacement layer (build/tmp/n18/pack-uncovered.txt is the list, docs/MIRRORS.md §7 shows the
#      `over "RootNode" { over "Looks" { over "mat_<HASH>" } }` recipe, and the pack is MIT).
#   Undo: delete this block's one live line, or tools/rtxprofile.sh current <game>.
#
# MEASURED OR NOT, stated plainly: the census, the coverage, the decoded roughness/metallic/height
# distributions, the option names and their defaults, and the source behaviour are measured
# (build/tmp/n18/census.txt, config/rtx-options-1.6.1.tsv, the 1.6.1 source). The BEFORE frame
# numbers are measured (build/tmp/n18/gap.json, build/tmp/n18/good-before.json). The AFTER numbers
# are not: rule 1 forbids running the game, wine or Steam, and a material change only becomes a
# number once the runtime draws a frame. The direction is derived from the source above; the
# after-measurement belongs to the next live run - docs/TARGET.md §6.



# ---------------------------------------------------------------------------
# n24 (2026-11-14, docs/STATUS.md V1/V3/V4, docs/FINDINGS.md "Night realism"): at night
# every photon comes from a real source. Two look keys here; the fallback light and the
# transmission approximation were changed in place above, and the plugin half (the night
# ceiling on rtx.skyBrightness, and a distant light's direction never pointing up) is in
# plugin/src/solar.cpp + plugin/src/sun.cpp. Numbers: .strata/notes-n24-*.md and
# `python3 tools/night_ambient.py`.
#
# WHY THESE TWO, WHEN CAUSE 1 IS ALREADY SHIPPED: n16 put the tonemapper in Global mode, and
# the scene's night ratio is still flattened - tools/night_ambient.py measures sand 150 units
# from any lamp at 4.1 % of the sand under a lamp head in scene-linear radiance (the ambient
# cap and the fallback light off, n23's lamps at 0.4) and at 36 % of it in the image with the
# curve at its defaults. The global curve fits one line to the frame's histogram and lifts the
# dark end of it; rtx.tonemap.shadowContrast is the key that pushes that end back down.
rtx.tonemap.shadowContrast = 0.4
#   "Additional gamma power to apply to the tone of the tone curve below shadowContrastEnd"
#   (config/rtx-options-1.6.1.tsv:904, default 0, never written by any profile of ours). The
#   curve pass subtracts shadowContrast x max(0, shadowContrastEnd - log2 L) from every bin
#   (tonemapping_tone_curve.comp.slang:198); shadowContrastEnd stays at its default 0, so
#   "values above this are unaffected" (rtx-options-1.6.1.tsv:905) means the noon ground -
#   log2 +0.36 after n22's day_ev -0.5 anchor - is untouched by construction and only material
#   below linear 1.0 gets the extra contrast. Measured on the sim's night metric points:
#     0.00 -> away sand 92/255, ratio 36.3 %   0.30 -> 30/255, 11.8 %
#     0.40 -> 19/255,  7.5 %   (shipped)       0.50 -> 11/255,  4.3 %
#     0.60 ->  6/255,  2.2 %   (the denoiser has nothing left to work with)
#   0.4 is the value: inside the <= 10 % target of n10 with margin, the moon-lit sand still
#   reads at 19/255, and the noon shadow penalty is 0.70 stops at linear 0.3 - under a stop,
#   and n16's own ladder already names this key ("the frame goes muddy ... use
#   rtx.tonemap.shadowContrast instead of the exposure"). A/B ladder if the live run says the
#   night is crushed: 0.3 (11.8 %, 30/255), then 0.2 (17.7 %, 45/255). Undo: delete the line
#   (the runtime default is 0).
rtx.bloom.luminanceThreshold = 1.0
#   "Adjust the bloom threshold to suppress blooming of the dim areas. Pixels with luminance
#   lower than the threshold are multiplied by the weight value that smoothly transitions from
#   1.0 (at luminance=threshold) to 0.0 (at luminance=0)" (rtx-options-1.6.1.tsv:67, default
#   0.25, written by no profile of ours until now; rtx.bloom.enable is True by default). Bloom
#   runs after the tone curve and before the sRGB encode, so the threshold is compared against
#   display-referred LINEAR luminance. Measured on the 60 frames of the 2026-11-12c video, in
#   the sea/pier band the teal-chroma scan puts the V4 glow in (y 841..941 of 1080, 11.52 M
#   pixels): 10.31 % of it is above 0.25 and blooms at FULL weight, 2.48 % above 0.5, and only
#   0.23 % is at or above 1.0; the band's mean linear luminance is 0.1005. So the shipped 0.25
#   turns a tenth of the sea into a bloom source - the halo of V4 - while a threshold of 1.0
#   cuts the fully-blooming area of that band 45x and still lets the clipped lamp heads and the
#   sun disc bloom. Undo: delete the line (back to 0.25).


# n01: the live temporal keys the shipped profile never wrote (see the header).
rtx.di.enableTemporalReuse = True
rtx.di.enableTemporalBiasCorrection = True
rtx.spatiallyHashedRadianceCache.maxNumFramesToAccumulate = 16
rtx.volumetrics.maxAccumulationFrames = 16
rtx.temporalAA.newFrameWeight = 0.35
rtx.autoExposure.autoExposureSpeed = 0.5
